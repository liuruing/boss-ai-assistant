{
  "manifest_version": 3,
  "name": "Boss直聘AI助手",
  "version": "1.1",
  "description": "AI分析简历和岗位JD，生成个性化打招呼语，提高Boss直聘回复率",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "http://192.168.123.83:48000/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon.png",
      "48": "assets/icon.png",
      "128": "assets/icon.png"
    }
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.zhipin.com/*"],
      "js": ["scripts/pdf-parser.js", "scripts/content.js"]
    }
  ],
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*",
        "scripts/*",
        "styles/*",
        "assets/*"
      ],
      "matches": ["https://www.zhipin.com/*"]
    }
  ]
}
